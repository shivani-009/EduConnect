# LOCAL DEV: mongodb://127.0.0.1:27017/educonnect
# PRODUCTION (Vercel): use a MongoDB Atlas connection string instead —
# Vercel serverless functions can't reach a MongoDB running on your laptop.
MONGO_URI=mongodb://127.0.0.1:27017/educonnect

JWT_SECRET=replace_this_with_a_long_random_string
PORT=5050

# The exact URL(s) of your deployed frontend, comma-separated if more than one.
# Example: https://educonnect.vercel.app
CLIENT_ORIGIN=http://localhost:5173
